Atividade 1 — Listas
Objetivo: Criar uma lista com 10 números, calcular soma, média, e resolver o desafio (maior/menor valor e quantidade de pares).

Python
# 1. Cria uma lista vazia para armazenar os números
numeros = []

# 2. Solicita os 10 valores ao usuário
for i in range(10):
    valor = int(input(f"Digite o {i + 1}º número inteiro: "))
    numeros.append(valor)

# 3. Exibe todos os números
print(f"\nNúmeros digitados: {numeros}")

# 4. Calcula a soma
soma = sum(numeros)
print(f"Soma: {soma}")

# 5. Calcula a média
media = soma / len(numeros)
print(f"Média: {media:.2f}")

# --- DESAFIO ---
# Encontrar o maior e o menor valor
print(f"Maior valor: {max(numeros)}")
print(f"Menor valor: {min(numeros)}")

# Quantidade de números pares
quantidade_pares = 0
for numero in numeros:
    if numero % 2 == 0:
        quantidade_pares += 1

print(f"Quantidade de números pares: {quantidade_pares}")
Atividade 2 — Matrizes
Objetivo: Criar uma matriz 3x3, preenchê-la, exibi-la, e calcular somas e o maior elemento.

Python
# Criando a matriz 3x3 e solicitando os valores
matriz = []

for i in range(3):
    linha = []
    for j in range(3):
        valor = int(input(f"Digite o valor para a posição [{i}][{j}]: "))
        linha.append(valor)
    matriz.append(linha)

# 1. Exibe a matriz
print("\nMatriz:")
for linha in matriz:
    for valor in linha:
        print(valor, end=" ")
    print()

# 2. Calcula a soma de todos os elementos
soma_total = sum(sum(linha) for linha in matriz)
print(f"\nSoma de todos os elementos: {soma_total}")

# 3. Calcula a soma da diagonal principal
soma_diagonal = 0
for i in range(len(matriz)):
    soma_diagonal += matriz[i][i]
print(f"Soma da diagonal principal: {soma_diagonal}")

# 4. Encontra o maior elemento
# Podemos assumir o primeiro elemento como referência inicial
maior = matriz[0][0]
for linha in matriz:
    for valor in linha:
        if valor > maior:
            maior = valor

print(f"Maior elemento da matriz: {maior}")
